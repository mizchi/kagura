{
  "format": "kagura.project",
  "version": 1,
  "name": "Fetch Image",
  "editor": {
    "id": "kagura.example2d",
    "apiVersion": 1
  },
  "scene": "editor/studio.json",
  "resources": {
    "asset.0": "assets/sample.png"
  },
  "id": "mizchi.kagura.examples.fetch_image",
  "game": "fetch_image",
  "save": {
    "namespace": "mizchi.kagura.examples.fetch_image",
    "version": 1
  },
  "runtime": {
    "kind": "script",
    "apiVersion": 1,
    "targets": [
      "js"
    ],
    "entry": "editor/dist/runtime.js"
  },
  "build": {
    "package": ".",
    "artifact": "fetch_image.js"
  },
  "display": {
    "width": 800,
    "height": 600
  },
  "sceneSchema": {
    "id": "kagura.example",
    "version": 1
  }
}
