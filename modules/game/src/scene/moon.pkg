import {
  "mizchi/signals/ui" @ui,
  "mizchi/kagura_core" @core,
  "mizchi/gfx" @gfx,
  "mizchi/kagura_engine/audio" @audio,
  "mizchi/kagura_engine/renderer2d" @renderer2d,
  "mizchi/kagura_engine/platform" @platform,
  "mizchi/kagura_engine/runtime" @runtime,
  "mizchi/kagura_engine" @engine,
}

warnings = "-6-53-68"

supported_targets = "js+native+wasm-gc"

options(
  targets: {
    "app.mbt": [ "js", "native" ],
    "game_api.mbt": [ "js", "native" ],
    "game_api_wbtest.mbt": [ "js", "native" ],
  },
)
