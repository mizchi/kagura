import {
  "mizchi/font",
  "mizchi/atlas",
  "mizchi/kagura_audio" @audio,
  "mizchi/kagura_core" @core,
  "mizchi/native_runtime_hooks" @native_hooks,
  "mizchi/gfx",
  "mizchi/kagura_native_runtime" @wgpu_native,
  "mizchi/renderer2d",
  "mizchi/atlas",
  "mizchi/kagura_platform" @platform,
  "mizchi/kagura_engine/runtime",
  "mizchi/kagura_engine/sprite2d",
  "mizchi/text",
  "mizchi/kagura_game/tilemap2d",
}

warnings = "-29"

supported_targets = "native"

pkgtype(kind: "executable")

options(
  link: {
    "native": {
      "cc": "${build.KAGURA_NATIVE_CC}",
      "cc-link-flags": "-L${build.KAGURA_NATIVE_WGPU_LIB_DIR} -lwgpu_native ${build.KAGURA_NATIVE_GLFW_LIBS} ${build.KAGURA_NATIVE_WGPU_RPATH} ${build.KAGURA_NATIVE_AUDIO_LIBS}",
    },
  },
  targets: {
    "embedded_test_font.mbt": [ "native" ],
    "main_native.mbt": [ "native" ],
    "main_stub.mbt": [ "js", "wasm", "wasm-gc", "llvm" ],
  },
)
