{
  "format": "kagura.project",
  "version": 1,
  "name": "Survivor",
  "editor": {
    "id": "kagura.example2d",
    "apiVersion": 1
  },
  "scene": "editor/studio.json",
  "resources": {},
  "id": "mizchi.kagura.examples.survivor",
  "game": "survivor",
  "save": {
