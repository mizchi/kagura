import {
  "moonbitlang/core/encoding/utf8" @utf8,
  "mizchi/kagura_engine/asset" @asset,
  "mizchi/kagura_engine/audio" @audio,
  "mizchi/kagura_core" @core,
  "mizchi/kagura_engine" @engine,
  "mizchi/kagura_engine/gfx" @gfx,
  "mizchi/kagura_core/image_palette" @image_palette,
  "mizchi/kagura_core/payload2d" @payload2d,
  "mizchi/kagura_engine/platform" @platform,
  "mizchi/kagura_engine/text" @text,
}

warnings = "-1-29"

supported_targets = "js+native+wasm+wasm-gc+llvm"

options(
  targets: {
    "hooks_js.mbt": [ "js" ],
    "hooks_llvm.mbt": [ "llvm" ],
    "hooks_stub.mbt": [ "native" ],
    "hooks_wasm.mbt": [ "wasm", "wasm-gc" ],
    "hooks_wbtest.mbt": [ "js", "llvm" ],
  },
)
