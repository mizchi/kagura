import {
  "mizchi/native_runtime_hooks/services" @native_services,
  "mizchi/kagura_platform/services",
  "mizchi/kagura_platform_web/services" @host_services,
  "mizchi/kagura_platform_web" @platform_web,
  "moonbitlang/core/encoding/utf8",
  "mizchi/atlas",
  "mizchi/kagura_audio" @audio,
  "mizchi/kagura_core" @core,
  "mizchi/kagura_engine" @engine,
  "mizchi/gfx",
  "mizchi/renderer2d",
  "mizchi/kagura_platform" @platform,
  "mizchi/text",
  "mizchi/kagura_ui" @ui,
}

warnings = "-1-29"

supported_targets = "js+native+wasm+wasm-gc+llvm"

options(
  targets: {
    "pointer_js.mbt": [ "js" ],
    "pointer_js_wbtest.mbt": [ "js" ],
    "pointer_other.mbt": [ "not", "js" ],
    "geometry_js.mbt": [ "js" ],
    "geometry_other.mbt": [ "native", "wasm", "wasm-gc", "llvm" ],
    "hooks_js.mbt": [ "js" ],
    "hooks_llvm.mbt": [ "llvm" ],
    "hooks_stub.mbt": [ "native" ],
    "hooks_wasm.mbt": [ "wasm", "wasm-gc" ],
    "hooks_wbtest.mbt": [ "js", "llvm" ],
  },
)
