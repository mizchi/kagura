import {
  "mizchi/font" @font,
  "mizchi/kagura/engine/asset" @asset,
  "mizchi/kagura/engine/audio" @audio,
  "mizchi/kagura/core" @core,
  "mizchi/web_runtime_hooks" @web_hooks,
  "mizchi/kagura/engine/gfx" @gfx,
  "mizchi/kagura/core/image_palette" @image_palette,
  "mizchi/kagura/core/payload2d" @payload2d,
  "mizchi/kagura/engine/platform" @platform,
  "mizchi/kagura/engine/runtime" @runtime,
  "mizchi/kagura/engine/sprite2d" @sprite2d,
  "mizchi/kagura/engine/text" @text,
  "mizchi/kagura/tilemap2d" @tilemap2d,
}

warnings = "-29"

options(
  "is-main": true,
  "supported-targets": [ "js", "wasm", "wasm-gc" ],
  targets: {
    "main_js.mbt": [ "js", "wasm", "wasm-gc", "llvm" ],
    "main_native.mbt": [ "native" ],
  },
)
