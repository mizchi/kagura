import {
  "mizchi/kagura_game/inspection",
  "mizchi/kagura_core/hierarchy",
  "moonbitlang/core/json",
  "mizchi/kagura_game/scene2d",
  "mizchi/flappy_bird/scenes",
  "moonbitlang/core/bench",
  "mizchi/signals",
  "mizchi/kagura_game/scene",
  "mizchi/kagura_ui" @kagura_ui,
  "mizchi/kagura_engine" @engine,
  "mizchi/kagura_core" @core,
  "mizchi/kagura_core/inpututil",
  "mizchi/web_runtime_hooks" @web_hooks,
}

// Native debug includes the inspection helpers for headless tests, but has no
// browser registration entry point. Keep upstream's unused-item warning policy
// for that profile. Release excludes these helpers and uses Control = Unit;
// the artifact gate checks removal independently of warning suppression.

warnings = "-29-1-2-7"

supported_targets = "js+native"

pkgtype(kind: "executable")

options(
  targets: {
    "scene_js.mbt": [ "and", "js", "debug" ],
    "scene_native.mbt": [ "or", "native", [ "and", "js", "release" ] ],
    "debug.mbt": [ "debug" ],
    "inspection.mbt": [ "debug" ],
    "debug_wbtest.mbt": [ "debug" ],
    "inspection_wbtest.mbt": [ "debug" ],
    "inspection_js.mbt": [ "and", "js", "debug" ],
    "view_inspection_debug.mbt": [ "debug" ],
    "view_inspection_release.mbt": [ "release" ],
    "verification_debug.mbt": [ "debug" ],
    "verification_release.mbt": [ "release" ],
  },
  link: {
    "native": {
      "cc": "${build.KAGURA_NATIVE_CC}",
      "cc-link-flags": "-L${build.KAGURA_NATIVE_WGPU_LIB_DIR} -lwgpu_native ${build.KAGURA_NATIVE_GLFW_LIBS} ${build.KAGURA_NATIVE_WGPU_RPATH} ${build.KAGURA_NATIVE_PLATFORM_LIBS}",
    },
  },
)
