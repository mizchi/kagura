import {
  "moonbitlang/core/bench" @bench,
  "mizchi/hacknslash_3d/game" @game,
  "mizchi/kagura_effect_studio" @effect,
  "mizchi/kagura/core/camera3d" @camera3d,
  "mizchi/kagura/core" @core,
  "mizchi/kagura/engine/draw3d" @draw3d,
  "mizchi/kagura/engine" @engine,
  "mizchi/kagura/gltf" @gltf,
  "mizchi/kagura/engine/gfx" @gfx,
  "mizchi/kagura/gameplay2d" @gameplay2d,
  "mizchi/kagura/core/inpututil" @inpututil,
  "mizchi/kagura/interactable2d" @interactable2d,
  "mizchi/kagura/engine/light3d" @light3d,
  "mizchi/kagura/core/math3d" @math3d,
  "mizchi/kagura/core/mesh3d" @mesh3d,
  "mizchi/kagura/scene" @scene,
  "mizchi/kagura/engine/scene3d" @scene3d,
  "mizchi/kagura/engine/shadow3d" @shadow3d,
  "mizchi/kagura/engine/particle3d" @particle3d,
  "mizchi/kagura/physics2d" @physics2d,
  "mizchi/kagura/engine/postfx" @postfx,
  "mizchi/kagura/engine/render_pipeline3d" @render_pipeline3d,
  "mizchi/kagura/core/skeleton3d" @skeleton3d,
  "mizchi/kagura/core/animation3d" @animation3d,
  "mizchi/kagura/engine/audio" @audio,
  "mizchi/kagura/core/transform3d" @transform3d,
  "mizchi/kagura/pathfind" @pathfind,
  "mizchi/kagura/core/vector" @vector,
  "mizchi/terrain/arena_chain" @arena_chain,
  "mizchi/terrain/types" @terrain,
  "mizchi/terrain/tinykeep" @tinykeep,
  "mizchi/web_runtime_hooks" @web_hooks,
  "mizchi/kagura/engine/text" @text,
  "mizchi/kagura/engine/asset" @asset,
  "mizchi/kagura/core/image_palette" @image_palette,
  "mizchi/kagura/engine/debugutil" @debugutil,
  "mizchi/kagura/hud" @hud,
  "mizchi/kagura/sprite_packer" @sprite_packer,
  "mizchi/kagura/engine/sprite2d" @sprite2d,
  "mizchi/kagura/engine/ui" @ui,
