import {
  "mizchi/kagura_game/inpututil",
  "moonbitlang/core/cmp",
  "moonbitlang/core/math",
  "mizchi/geom/camera2d",
  "mizchi/kagura_core" @core,
  "mizchi/kagura_engine" @engine,
  "mizchi/kagura_core/inputstate",
  "mizchi/pathfind",
  "mizchi/kagura_engine/scene",
  "mizchi/geom/vector",
  "mizchi/terrain/bsp",
  "mizchi/terrain/types" @terrain,
  "mizchi/web_runtime_hooks" @web_hooks,
}

warnings = "-1-2-7-29"

supported_targets = "js"

pkgtype(kind: "executable")

options(
  targets: {
    "verification_debug.mbt": [ "debug" ],
    "verification_release.mbt": [ "release" ],
  },
)
