import {
  "mizchi/atlas",
  "mizchi/kagura_engine" @engine,
  "mizchi/gfx",
  "mizchi/kagura_engine/sprite2d",
  "mizchi/web_runtime_hooks" @web_hooks,
}

warnings = "-1-2-29"

supported_targets = "js"

pkgtype(kind: "executable")

options(
  targets: {
    "main.mbt": [ "js" ],
    "main_stub.mbt": [ "native", "wasm", "wasm-gc", "llvm" ],
  },
)
