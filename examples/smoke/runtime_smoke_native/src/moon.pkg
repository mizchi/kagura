import {
  "mizchi/font" @font,
  "mizchi/kagura_engine/asset" @asset,
  "mizchi/kagura_engine/audio" @audio,
  "mizchi/kagura_core" @core,
  "mizchi/native_runtime_hooks" @native_hooks,
  "mizchi/gfx" @gfx,
  "mizchi/kagura_engine/gfx_wgpu_native" @wgpu_native,
  "mizchi/kagura_engine/renderer2d" @renderer2d,
  "mizchi/kagura_core/image_palette" @image_palette,
  "mizchi/kagura_engine/platform" @platform,
  "mizchi/kagura_engine/runtime" @runtime,
  "mizchi/kagura_engine/sprite2d" @sprite2d,
  "mizchi/kagura_engine/text" @text,
  "mizchi/kagura_game/tilemap2d" @tilemap2d,
}

warnings = "-29"

supported_targets = "native"

options(
  "is-main": true,
  link: {
    "native": {
      "cc": "${build.KAGURA_NATIVE_CC}",
      "cc-link-flags": "-L../../deps/wgpu-native/lib -lwgpu_native ${build.KAGURA_NATIVE_GLFW_LIBS} ${build.KAGURA_NATIVE_WGPU_RPATH} ${build.KAGURA_NATIVE_AUDIO_LIBS}",
    },
  },
  targets: {
    "embedded_test_font.mbt": [ "native" ],
    "main_native.mbt": [ "native" ],
    "main_stub.mbt": [ "js", "wasm", "wasm-gc", "llvm" ],
  },
)
