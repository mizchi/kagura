;; A reusable-buffer wasm32 example. Build substitutes UTF-8 manifest bytes and length.
(module
  (memory (export "memory") 1 256)
  (global $length (mut i32) (i32.const 0))
  (data (i32.const 0) "{{MANIFEST}}")
  (data (i32.const 2048) "{\22result\22:")
  (func (export "kagura_alloc") (param $length i32) (result i32)
    (local $pages i32)
    (local.set $pages (i32.div_u (i32.add (i32.add (i32.mul (local.get $length) (i32.const 2)) (i32.const 4107)) (i32.const 65535)) (i32.const 65536)))
    (if (i32.gt_u (local.get $pages) (memory.size))
      (then (drop (memory.grow (i32.sub (local.get $pages) (memory.size))))))
    (i32.const 4096))
  ;; Input/output buffers are reused only after the synchronous caller has finished reading.
  (func (export "kagura_free") (param i32 i32))
  (func (export "kagura_manifest") (result i32)
    (global.set $length (i32.const {{MANIFEST_LENGTH}})) (i32.const 0))
  (func (export "kagura_result_len") (result i32) (global.get $length))
  (func (export "kagura_invoke") (param $ptr i32) (param $len i32) (result i32)
    (local $out i32)
    (local.set $out (i32.add (local.get $ptr) (local.get $len)))
    (memory.copy (local.get $out) (i32.const 2048) (i32.const 10))
    (memory.copy (i32.add (local.get $out) (i32.const 10)) (local.get $ptr) (local.get $len))
    (i32.store8 (i32.add (i32.add (local.get $out) (i32.const 10)) (local.get $len)) (i32.const 125))
    (global.set $length (i32.add (local.get $len) (i32.const 11)))
    (local.get $out))
)
