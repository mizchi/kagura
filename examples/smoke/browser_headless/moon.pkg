import {
  "mizchi/kagura_engine" @engine,
  "mizchi/gfx",
  "mizchi/renderer2d",
  "mizchi/widget2d",
  "mizchi/native_runtime_hooks/gfx_wgpu_native" @wgpu_native,
  "mizchi/native_runtime_hooks" @native_hooks,
  "mizchi/crater-renderer/renderer",
  "mizchi/crater-painter/paint",
  "mizchi/crater-core" @crater_types,
  "mizchi/css/values" @css,
  "mizchi/crater-browser/shell",
  "mizchi/crater-browser-native/js_v8",
}

warnings = "-1-2-29"

supported_targets = "native"

pkgtype(kind: "executable")

options(
  link: {
    "native": {
      "cc": "${build.KAGURA_NATIVE_CC}",
      "cc-link-flags": "-L${build.KAGURA_NATIVE_WGPU_LIB_DIR} -lwgpu_native ${build.KAGURA_NATIVE_GLFW_LIBS} ${build.KAGURA_NATIVE_WGPU_RPATH} ${build.KAGURA_NATIVE_PLATFORM_LIBS} ${build.MIZCHI_V8_CC_LINK_FLAGS}",
    },
  },
  targets: {
    "main_native.mbt": [ "native" ],
    "main_stub.mbt": [ "js", "wasm", "wasm-gc", "llvm" ],
  },
)
