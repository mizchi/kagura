import {
  "mizchi/kagura/asset" @asset,
  "mizchi/kagura/audio" @audio,
  "mizchi/kagura/core" @core,
  "mizchi/kagura/engine" @engine,
  "mizchi/kagura/gfx" @gfx,
  "mizchi/kagura/gfx_wgpu_native" @wgpu_native,
  "mizchi/kagura/image_palette" @image_palette,
  "mizchi/kagura/payload2d" @payload2d,
  "mizchi/kagura/platform" @platform,
  "mizchi/kagura/text" @text,
}

warnings = "-1-7-29"

options(
  link: {
    "native": {
      "cc": "../../scripts/moon-native-cc.sh",
      "cc-link-flags": "-L../../deps/wgpu-native/lib -lwgpu_native ${build.KAGURA_NATIVE_GLFW_LIBS} -Wl,-rpath,../../deps/wgpu-native/lib ${build.KAGURA_NATIVE_AUDIO_LIBS}",
    },
  },
  targets: {
    "hooks_native.mbt": [ "native" ],
    "hooks_native_wbtest.mbt": [ "js" ],
    "hooks_stub.mbt": [ "js", "wasm", "wasm-gc", "llvm" ],
  },
)
