import {
  "mizchi/glfw" @glfw,
}

options(
  link: {
    "native": {
      "cc": "clang",
      "cc-flags": "-Ideps/wgpu-native/include -I/usr/local/include -Ideps/miniaudio",
      "cc-link-flags": "-Ldeps/wgpu-native/lib -lwgpu_native -lglfw -Wl,-rpath,deps/wgpu-native/lib ${build.KAGURA_NATIVE_AUDIO_LIBS}",
    },
  },
  "native-stub": [ "wgpu_native_stub.m" ],
  "supported-targets": [ "native" ],
  targets: {
    "backend.mbt": [ "native" ],
    "native_io_bindings.mbt": [ "native" ],
    "runtime_bridge.mbt": [ "native" ],
    "runtime_bridge_wbtest.mbt": [ "native" ],
    "wgpu_bindings.mbt": [ "native" ],
    "wgpu_bindings_wbtest.mbt": [ "native" ],
  },
)
