{
  "format": "kagura.project",
  "version": 1,
  "name": "FATHOM",
  "editor": {
    "id": "kagura.example2d",
    "apiVersion": 1
  },
  "scene": "editor/studio.json",
  "resources": {
    "host": "assets/host.mjs",
    "style": "assets/style.css",
    "party": "assets/party-atlas.png",
    "masterData": "assets/master-data.json",
    "sceneFlow": "editor/scene-flow.json"
  },
  "id": "mizchi.kagura.examples.dungeon_rpg",
  "game": "dungeon_rpg",
  "save": {
    "namespace": "mizchi.kagura.examples.dungeon_rpg",
    "version": 1
  },
  "runtime": {
    "kind": "script",
    "apiVersion": 1,
    "targets": [
      "js",
      "native"
    ],
    "entry": "editor/dist/runtime.js"
  },
  "build": {
    "package": ".",
    "artifact": "dungeon_rpg.js"
  },
  "display": {
    "width": 960,
    "height": 600
  },
  "sceneSchema": {
    "id": "kagura.example",
    "version": 1
  },
  "masterData": {
    "adapter": "assets/master-data-adapter.mjs",
    "resource": "masterData"
  },
  "sceneFlow": {
    "resource": "sceneFlow"
  }
}
