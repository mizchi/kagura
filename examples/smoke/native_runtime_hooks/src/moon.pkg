import {
  "mizchi/kagura_engine/asset" @asset,
  "mizchi/kagura_engine/audio" @audio,
  "mizchi/kagura_core" @core,
  "mizchi/kagura_engine" @engine,
  "mizchi/gfx" @gfx,
  "mizchi/kagura_engine/gfx_wgpu_native" @wgpu_native,
  "mizchi/kagura_core/image_palette" @image_palette,
  "mizchi/kagura_core/payload2d" @payload2d,
  "mizchi/kagura_engine/platform" @platform,
  "mizchi/text" @text,
}

warnings = "-1-7-29"

supported_targets = "native"

options(
  link: {
    "native": {
      "cc": "${build.KAGURA_NATIVE_CC}",
      "cc-link-flags": "-L../../deps/wgpu-native/lib -lwgpu_native ${build.KAGURA_NATIVE_GLFW_LIBS} ${build.KAGURA_NATIVE_WGPU_RPATH} ${build.KAGURA_NATIVE_AUDIO_LIBS}",
    },
  },
  targets: {
    "hooks_native.mbt": [ "native" ],
    "hooks_native_wbtest.mbt": [ "js" ],
    "hooks_stub.mbt": [ "js", "wasm", "wasm-gc", "llvm" ],
  },
)
