import {
  "mizchi/kagura_engine" @engine,
  "mizchi/gfx" @gfx,
  "mizchi/renderer2d" @renderer2d,
  "mizchi/widget2d" @widget2d,
  "mizchi/kagura_native_runtime" @wgpu_native,
  "mizchi/native_runtime_hooks" @native_hooks,
  "mizchi/crater-renderer/renderer" @renderer,
  "mizchi/crater-painter/paint" @paint,
  "mizchi/crater-layout/types" @crater_types,
  "mizchi/crater-browser/shell" @shell,
  "mizchi/crater-browser-native/js_v8" @js_v8,
}

warnings = "-1-2-29"

supported_targets = "native"

options(
  "is-main": true,
  link: {
    "native": {
      "cc": "${build.KAGURA_NATIVE_CC}",
      "cc-link-flags": "-L${build.KAGURA_NATIVE_WGPU_LIB_DIR} -lwgpu_native ${build.KAGURA_NATIVE_GLFW_LIBS} ${build.KAGURA_NATIVE_WGPU_RPATH} ${build.KAGURA_NATIVE_PLATFORM_LIBS} ${build.MIZCHI_V8_CC_LINK_FLAGS}",
    },
  },
  targets: {
    "main_native.mbt": [ "native" ],
    "main_stub.mbt": [ "js", "wasm", "wasm-gc", "llvm" ],
  },
)
