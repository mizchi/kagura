import {
  "mizchi/kagura_engine/audio" @audio,
  "mizchi/glfw" @glfw,
}

supported_targets = "native"

options(
  link: {
    "native": {
      "cc": "${build.KAGURA_NATIVE_CC}",
      "cc-flags": "-I${build.KAGURA_NATIVE_WGPU_INCLUDE} -I${build.KAGURA_NATIVE_MINIAUDIO_INCLUDE} ${build.KAGURA_NATIVE_GLFW_CFLAGS}",
      "cc-link-flags": "-L${build.KAGURA_NATIVE_WGPU_LIB_DIR} -lwgpu_native ${build.KAGURA_NATIVE_GLFW_LIBS} ${build.KAGURA_NATIVE_WGPU_RPATH} ${build.KAGURA_NATIVE_AUDIO_LIBS}",
    },
  },
  "native-stub": [ "wgpu_native_stub.c", "wgpu_native_stub_macos.m" ],
  targets: {
    "audio_backend.mbt": [ "native" ],
    "audio_backend_wbtest.mbt": [ "native" ],
    "backend.mbt": [ "native" ],
    "native_io_bindings.mbt": [ "native" ],
    "runtime_bridge.mbt": [ "native" ],
    "runtime_bridge_wbtest.mbt": [ "native" ],
    "wgpu_bindings.mbt": [ "native" ],
    "wgpu_bindings_wbtest.mbt": [ "native" ],
  },
)
