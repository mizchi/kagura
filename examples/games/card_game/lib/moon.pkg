import {
  "mizchi/card_game/flow",
  "mizchi/kagura_engine/inspection",
  "mizchi/kagura_game/inpututil",
  "moonbitlang/core/math",
  "mizchi/signals",
  "mizchi/kagura_engine/scene",
  "mizchi/kagura_ui" @ui,
  "mizchi/kagura_engine/runtime",
  "mizchi/kagura_engine/capture",
  "mizchi/kagura_core" @core,
  "mizchi/kagura_core/inputstate",
  "moonbitlang/core/debug",
  "moonbitlang/core/json",
}

warnings = "-29"

supported_targets = "js+native"

options(
  targets: {
    "inspection_js.mbt": [ "js" ],
    "inspection_native.mbt": [ "native" ],
    "preview_debug.mbt": [ "debug" ],
    "pointer_surface_js.mbt": [ "js" ],
    "pointer_surface_native.mbt": [ "native" ],
  },
)
