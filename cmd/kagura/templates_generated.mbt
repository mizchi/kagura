let web_template_files : Array[(String, String)] = [
  (".gitignore", "_build/\n.mooncakes/\nnode_modules/\ndist/\n"),
  ("README.md", "# __PROJECT_NAME__\n\nA MoonBit game using Kagura's released Web runtime.\n\nRequires Node.js 24+, pnpm, MoonBit, and a WebGPU browser. The Mooncakes\ndependencies in `moon.mod` require the Kagura release containing the new layout.\n\n```sh\npnpm install\nkagura dev                  # http://127.0.0.1:8080\nkagura build                # dist/\n```\n\n`pnpm dev`, `pnpm build`, and the provided `justfile` also work without the CLI.\nMove the green character with WASD or the arrow keys. Edit `main.mbt` to change\nthe game; the dev server rebuilds and reloads it automatically.\n\nPublish the contents of `dist/` to a static HTTP host. Relative URLs support\nsubdirectory deployments. No Kagura checkout or local path dependency is needed.\n\n`username/__PROJECT_NAME__` is the starter module name. When changing it, update\nboth `moon.mod` and the `mbt:` import in `web.mjs`.\n\nThe generated `runtime/` contains the matching browser host distribution\n(Apache-2.0), not the engine's MoonBit source. Keep it with this project.\n"),
  ("index.html", "<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n    <title>__PROJECT_NAME__</title>\n    <style>\n      * {box-sizing: border-box}\n      body {margin: 0; min-height: 100svh; display: grid; place-items: center; color: #dcebe9; background: #08111d; font: 16px system-ui}\n      main {width: min(100%, 960px); padding: 24px}\n      header {display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap}\n      h1 {font-size: 24px; letter-spacing: .04em}\n      p {color: #9aabb9}\n      canvas {display: block; width: 100%; aspect-ratio: 10 / 7; background: #101c2a; border: 1px solid #284154; border-radius: 12px}\n    </style>\n  </head>\n  <body>\n    <main>\n      <header><h1>__PROJECT_NAME__</h1><p>Move with WASD or the arrow keys</p></header>\n      <canvas id=\"app\" width=\"800\" height=\"560\" aria-label=\"Game\"></canvas>\n    </main>\n    <script type=\"module\" src=\"./web.mjs\"></script>\n  </body>\n</html>\n"),
  ("justfile", "default:\n    @just --list\n\ninstall:\n    pnpm install\n\n[positional-arguments]\ndev *args:\n    pnpm dev \"$@\"\n\n[positional-arguments]\nbuild *args:\n    pnpm build \"$@\"\n\ncheck:\n    moon check --target js --deny-warn\n\ntest:\n    moon test --target js\n"),
  ("kagura.json", "{\"schemaVersion\": 1, \"template\": \"web\"}\n"),
  ("main.mbt", "///|\nstruct Player {\n  mut x : Double\n  mut y : Double\n}\n\n///|\nfn main {\n  @web_hooks.install(\"#app\")\n  let player = Player::{ x: 400, y: 280 }\n  @engine.run(\n    update=fn(input : @core.InputSnapshot) {\n      // The web host translates KeyboardEvent.code, so layouts such as Dvorak work.\n      let keys = input.pressed_keys\n      let dx = (if keys.contains(68) || keys.contains(39) { 1.0 } else { 0.0 }) -\n        (if keys.contains(65) || keys.contains(37) { 1.0 } else { 0.0 })\n      let dy = (if keys.contains(83) || keys.contains(40) { 1.0 } else { 0.0 }) -\n        (if keys.contains(87) || keys.contains(38) { 1.0 } else { 0.0 })\n      let speed = if dx != 0 && dy != 0 { 2.12 } else { 3.0 }\n      player.x = (player.x + dx * speed).clamp(min=24, max=776)\n      player.y = (player.y + dy * speed).clamp(min=24, max=536)\n    },\n    draw=fn(ctx) {\n      let commands : Array[@gfx.DrawTrianglesCommand] = []\n      let frame = @renderer2d.RenderFrame2D::new(\n        dst=ctx.dst, shader=ctx.shader, screen_w=800, screen_h=560,\n      )\n      @renderer2d.append_rect_fill(commands, frame, @renderer2d.RectFill2D::new(\n        x=0, y=0, w=800, h=560, color=@renderer2d.color_from_hex(0x101C2A),\n      ))\n      for column in 0..<20 {\n        @renderer2d.append_rect_fill(commands, frame, @renderer2d.RectFill2D::new(\n          x=column.to_double() * 40, y=0, w=1, h=560,\n          color=@renderer2d.color_from_hex(0x203448),\n        ))\n      }\n      for row in 0..<14 {\n        @renderer2d.append_rect_fill(commands, frame, @renderer2d.RectFill2D::new(\n          x=0, y=row.to_double() * 40, w=800, h=1,\n          color=@renderer2d.color_from_hex(0x203448),\n        ))\n      }\n      @renderer2d.append_rect_fill(commands, frame, @renderer2d.RectFill2D::new(\n        x=player.x - 19, y=player.y - 14, w=38, h=38,\n        color=@renderer2d.color_from_hex(0x08111D),\n      ))\n      @renderer2d.append_rect_fill(commands, frame, @renderer2d.RectFill2D::new(\n        x=player.x - 16, y=player.y - 16, w=32, h=32,\n        color=@renderer2d.color_from_hex(0x64E4C0),\n      ))\n      commands\n    },\n    width=800, height=560, title=\"__PROJECT_NAME__\", canvas=\"#app\",\n  )\n}\n"),
  ("moon.mod", "name = \"username/__PROJECT_NAME__\"\n\nversion = \"0.1.0\"\n\nlicense = \"Apache-2.0\"\n\npreferred_target = \"js\"\n\nimport {\n  \"mizchi/kagura_engine@0.2.0\",\n  \"mizchi/kagura_core@0.2.0\",\n  \"mizchi/renderer2d@0.2.0\",\n  \"mizchi/gfx@0.1.0\",\n  \"mizchi/web_runtime_hooks@0.1.0\",\n}\n"),
  ("moon.pkg", "import {\n  \"mizchi/kagura_core\" @core,\n  \"mizchi/kagura_engine\" @engine,\n  \"mizchi/renderer2d\",\n  \"mizchi/gfx\",\n  \"mizchi/web_runtime_hooks\" @web_hooks,\n}\n\nsupported_targets = \"js\"\n\npkgtype(kind: \"executable\")\n"),
  ("package.json", "{\n  \"name\": \"__PROJECT_NAME__\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"packageManager\": \"pnpm@10.33.0\",\n  \"engines\": {\"node\": \">=24\"},\n  \"scripts\": {\n    \"dev\": \"vite --host 127.0.0.1 --port 8080 --strictPort\",\n    \"build\": \"vite build\",\n    \"preview\": \"vite preview --host 127.0.0.1\",\n    \"check\": \"moon check --target js --deny-warn\"\n  },\n  \"devDependencies\": {\n    \"vite\": \"8.2.2\",\n    \"vite-plugin-moonbit\": \"0.5.1\"\n  },\n  \"pnpm\": {\"onlyBuiltDependencies\": [\"esbuild\"]}\n}\n"),
  ("vite.config.mjs", "import {defineConfig} from 'vite';\nimport {moonbit} from 'vite-plugin-moonbit';\nimport {execFile} from 'node:child_process';\nimport {promisify} from 'node:util';\n\nconst run = promisify(execFile);\n\nexport default defineConfig(async ({command}) => {\n  const release = command === 'build';\n  let pending = Promise.resolve();\n  function buildMoon() {\n    // Serialize rebuilds. A change during compilation must not be lost.\n    pending = pending.catch(() => {}).then(async () => {\n      const {stdout, stderr} = await run('moon', ['build', '.', '--target', 'js', ...(release ? ['--release'] : [])], {\n        cwd: import.meta.dirname, maxBuffer: 16 * 1024 * 1024,\n      });\n      if (stdout) process.stdout.write(stdout);\n      if (stderr) process.stderr.write(stderr);\n    });\n    return pending;\n  }\n  await buildMoon();\n  return {\n    base: './',\n    plugins: [\n      moonbit({root: import.meta.dirname, target: 'js', mode: release ? 'release' : 'debug', watch: false}),\n      {\n        name: 'kagura-moonbit-reload',\n        async handleHotUpdate({file, server}) {\n          if (!/\\.(mbt|mbti)$|\\/moon\\.(pkg|mod)(\\.json)?$/.test(file.replaceAll('\\\\', '/'))) return;\n          try {\n            await buildMoon();\n          } catch (error) {\n            server.ws.send({type: 'error', err: {message: error.stderr || error.message, stack: ''}});\n            return [];\n          }\n          // The game owns a frame loop and GPU state. Restart after a successful\n          // compile, using process completion rather than Moon's terminal output.\n          server.moduleGraph.invalidateAll();\n          server.ws.send({type: 'full-reload', path: '*'});\n          return [];\n        },\n      },\n    ],\n    server: {strictPort: true},\n    build: {target: 'esnext'},\n  };\n});\n"),
  ("web.mjs", "import {initWebGPU, setupGlobalState, showStartupError} from './runtime/kagura-init.js';\nimport {installAudioHelpers} from './runtime/kagura-audio.js';\nimport {installGfxHelpers} from './runtime/kagura-gfx.js';\n\ntry {\n  const gpu = await initWebGPU('#app');\n  if (!gpu) throw new Error('WebGPU is required. Open this page in a browser with WebGPU enabled.');\n  setupGlobalState(gpu.canvas, gpu.device, gpu.format, gpu.context);\n  installAudioHelpers();\n  installGfxHelpers();\n  await import('mbt:username/__PROJECT_NAME__');\n} catch (error) {\n  showStartupError('#app', 'Unable to start the game', error.message);\n  throw error;\n}\n"),
