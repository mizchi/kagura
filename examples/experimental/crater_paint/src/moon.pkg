import {
  "mizchi/kagura_engine" @engine,
  "mizchi/gfx" @gfx,
  "mizchi/kagura_native_runtime" @wgpu_native,
  "mizchi/atlas" @atlas,
  "mizchi/renderer2d" @renderer2d,
  "mizchi/widget2d" @widget2d,
  "mizchi/text" @text,
  "mizchi/native_runtime_hooks" @native_hooks,
  "mizchi/crater-renderer/renderer" @renderer,
  "mizchi/crater-dom/html" @html,
  "mizchi/crater-painter/paint" @paint,
  "mizchi/crater-layout/types" @crater_types,
  "mizchi/font" @font,
  "mizchi/image" @image,
  "moonbitlang/core/string" @string,
}

warnings = "-1-2-29"

supported_targets = "native"

options(
  "is-main": true,
  link: {
    "native": {
      "cc": "${build.KAGURA_NATIVE_CC}",
      "cc-link-flags": "-L${build.KAGURA_NATIVE_WGPU_LIB_DIR} -lwgpu_native ${build.KAGURA_NATIVE_GLFW_LIBS} ${build.KAGURA_NATIVE_WGPU_RPATH} ${build.KAGURA_NATIVE_PLATFORM_LIBS}",
    },
  },
  targets: {
    "main_native.mbt": [ "native" ],
    "main_stub.mbt": [ "js", "wasm", "wasm-gc", "llvm" ],
  },
)
