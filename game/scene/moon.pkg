import {
  "moonbitlang/core/bench",
  "mizchi/kagura_core/hierarchy",
  "mizchi/signals/ui",
  "mizchi/kagura_core" @core,
  "mizchi/gfx",
  "mizchi/kagura_audio" @audio,
  "mizchi/renderer2d",
  "mizchi/kagura_platform" @platform,
  "mizchi/kagura_engine/runtime",
  "mizchi/kagura_engine" @engine,
  "moonbitlang/core/debug",
