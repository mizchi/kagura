import {
  "moonbitlang/core/math" @math,
  "mizchi/geom/camera3d" @camera3d,
  "mizchi/kagura_core" @core,
  "mizchi/kagura_engine/draw3d" @draw3d,
  "mizchi/kagura_engine" @engine,
  "mizchi/gfx" @gfx,
  "mizchi/kagura_core/inpututil" @inpututil,
  "mizchi/kagura_engine/light3d" @light3d,
  "mizchi/geom/math3d" @math3d,
  "mizchi/mesh3d" @mesh3d,
  "mizchi/kagura_physics/physics3d" @physics3d,
  "mizchi/kagura_engine/renderer3d" @renderer3d,
  "mizchi/kagura_engine/scene3d" @scene3d,
  "mizchi/anim3d/transform3d" @transform3d,
  "mizchi/web_runtime_hooks" @web_hooks,
}

warnings = "-1-2-29"

supported_targets = "js+native"

options(
  "is-main": true,
  link: {
    "native": {
      "cc": "${build.KAGURA_NATIVE_CC}",
      "cc-link-flags": "-L../../deps/wgpu-native/lib -lwgpu_native ${build.KAGURA_NATIVE_GLFW_LIBS} ${build.KAGURA_NATIVE_WGPU_RPATH} ${build.KAGURA_NATIVE_PLATFORM_LIBS}",
    },
  },
)
