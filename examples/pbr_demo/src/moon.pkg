import {
  "moonbitlang/core/math" @math,
  "mizchi/kagura/core/camera3d" @camera3d,
  "mizchi/kagura/core" @core,
  "mizchi/kagura/engine/draw3d" @draw3d,
  "mizchi/kagura/engine" @engine,
  "mizchi/kagura/engine/gfx" @gfx,
  "mizchi/kagura/engine/light3d" @light3d,
  "mizchi/kagura/core/math3d" @math3d,
  "mizchi/kagura/core/mesh3d" @mesh3d,
  "mizchi/kagura/engine/scene3d" @scene3d,
  "mizchi/web_runtime_hooks" @web_hooks,
  "mizchi/native_runtime_hooks" @native_hooks,
}

warnings = "-1-2-29-71"

options(
  "is-main": true,
  "supported-targets": [ "native" ],
  link: {
    "native": {
      "cc": "${build.KAGURA_NATIVE_CC}",
      "cc-link-flags": "-L../../deps/wgpu-native/lib -lwgpu_native ${build.KAGURA_NATIVE_GLFW_LIBS} ${build.KAGURA_NATIVE_WGPU_RPATH} ${build.KAGURA_NATIVE_PLATFORM_LIBS}",
    },
  },
)
