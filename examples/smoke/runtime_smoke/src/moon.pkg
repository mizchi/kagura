import {
  "mizchi/font",
  "mizchi/atlas",
  "mizchi/kagura_engine/audio",
  "mizchi/kagura_core" @core,
  "mizchi/web_runtime_hooks" @web_hooks,
  "mizchi/gfx",
  "mizchi/atlas",
  "mizchi/renderer2d",
  "mizchi/kagura_platform" @platform,
  "mizchi/kagura_engine/runtime",
  "mizchi/kagura_engine/sprite2d",
  "mizchi/text",
  "mizchi/kagura_game/tilemap2d",
}

warnings = "-29"

supported_targets = "js+wasm+wasm-gc"

pkgtype(kind: "executable")

options(
  targets: {
    "main_js.mbt": [ "js", "wasm", "wasm-gc", "llvm" ],
    "main_native.mbt": [ "native" ],
  },
)
