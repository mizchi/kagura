import {
  "mizchi/font" @font,
  "mizchi/kagura/ai" @ai,
  "mizchi/kagura/engine/asset" @asset,
  "mizchi/kagura/engine/audio" @audio,
  "mizchi/kagura/core/camera2d" @camera2d,
  "mizchi/kagura/engine/colorm" @colorm,
  "mizchi/kagura/core" @core,
  "mizchi/kagura/engine/gfx" @gfx,
  "mizchi/kagura/core/image_palette" @image_palette,
  "mizchi/kagura/core/inpututil" @inpututil,
  "mizchi/kagura/scene" @scene,
  "mizchi/kagura/core/svg" @svg,
  "mizchi/kagura/engine/text" @text,
  "mizchi/kagura/tilemap2d" @tilemap2d,
  "mizchi/kagura/engine/ui" @ui,
  "mizchi/kagura/core/vector" @vector,
  "mizchi/web_runtime_hooks" @web_hooks,
}

warnings = "-1-2-7-20-29-71"

options(
  "is-main": true,
  "supported-targets": [ "js", "native" ],
  link: {
    "native": {
      "cc": "${build.KAGURA_NATIVE_CC}",
      "cc-link-flags": "-L../../deps/wgpu-native/lib -lwgpu_native ${build.KAGURA_NATIVE_GLFW_LIBS} ${build.KAGURA_NATIVE_WGPU_RPATH} ${build.KAGURA_NATIVE_PLATFORM_LIBS}",
    },
  },
)
