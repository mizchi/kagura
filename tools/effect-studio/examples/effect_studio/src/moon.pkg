import {
  "moonbitlang/core/math" @math,
  "mizchi/kagura_effect_studio" @effect,
  "mizchi/kagura_core/camera3d" @camera3d,
  "mizchi/kagura_core" @core,
  "mizchi/kagura_engine/draw3d" @draw3d,
  "mizchi/kagura_engine" @engine,
  "mizchi/gfx" @gfx,
  "mizchi/kagura_game/hud" @hud,
  "mizchi/kagura_core/inpututil" @inpututil,
  "mizchi/kagura_engine/light3d" @light3d,
  "mizchi/math3d" @math3d,
  "mizchi/kagura_core/mesh3d" @mesh3d,
  "mizchi/kagura_engine/particle3d" @particle3d,
  "mizchi/web_runtime_hooks" @web_hooks,
}

warnings = "-1-2-29"

supported_targets = "js+native"

options(
  "is-main": true,
  link: {
    "native": {
      "cc": "${build.KAGURA_NATIVE_CC}",
      "cc-link-flags": "-L../../../../../deps/wgpu-native/lib -lwgpu_native ${build.KAGURA_NATIVE_GLFW_LIBS} -Wl,-rpath,../../../../../deps/wgpu-native/lib ${build.KAGURA_NATIVE_PLATFORM_LIBS}",
    },
  },
  targets: {
    "main.mbt": [ "js" ],
    "main_native.mbt": [ "native" ],
    "main_stub.mbt": [ "wasm", "wasm-gc", "llvm" ],
  },
)
