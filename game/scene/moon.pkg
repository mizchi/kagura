warnings = "-6-53-68"

supported_targets = "js+native+wasm-gc"

options(
  targets: {
    "inspection_release_wbtest.mbt": [ "release" ],
    "subject_debug.mbt": [ "debug" ],
    "subject_release.mbt": [ "release" ],
    "app.mbt": [ "js", "native" ],
    "game_api.mbt": [ "js", "native" ],
    "game_api_wbtest.mbt": [ "js", "native" ],
  },
)
