import {
  "moonbitlang/core/bench" @bench,
  "moonbitlang/core/cmp" @cmp,
  "moonbitlang/core/math" @math,
  "mizchi/font" @font,
  "mizchi/kagura_game/ai" @ai,
  "mizchi/kagura_engine/asset" @asset,
  "mizchi/kagura_engine/audio" @audio,
  "mizchi/kagura_core/camera2d" @camera2d,
  "mizchi/kagura_engine/colorm" @colorm,
  "mizchi/kagura_core" @core,
  "mizchi/gfx" @gfx,
  "mizchi/kagura_core/image_palette" @image_palette,
  "mizchi/kagura_core/inpututil" @inpututil,
  "mizchi/kagura_game/scene" @scene,
  "mizchi/kagura_core/svg" @svg,
  "mizchi/text" @text,
  "mizchi/kagura_game/tilemap2d" @tilemap2d,
  "mizchi/kagura_engine/ui" @ui,
  "mizchi/kagura_core/vector" @vector,
  "mizchi/web_runtime_hooks" @web_hooks,
}

warnings = "-1-2-7-29"

supported_targets = "js+native"

options(
  "is-main": true,
  link: {
    "native": {
      "cc": "${build.KAGURA_NATIVE_CC}",
      "cc-link-flags": "-L../../deps/wgpu-native/lib -lwgpu_native ${build.KAGURA_NATIVE_GLFW_LIBS} ${build.KAGURA_NATIVE_WGPU_RPATH} ${build.KAGURA_NATIVE_PLATFORM_LIBS}",
    },
  },
)
