import {
  "moonbitlang/core/math",
  "mizchi/kagura_audio" @audio,
  "mizchi/iron_yard/sim",
  "mizchi/iron_yard/rig",
  "mizchi/kagura_engine" @engine,
  "mizchi/kagura_core" @core,
  "mizchi/kagura_engine/draw3d",
  "mizchi/kagura_engine/postfx",
  "mizchi/kagura_engine/shadow3d",
  "mizchi/kagura_engine/light3d",
  "mizchi/geom/math3d",
  "mizchi/geom/camera3d",
  "mizchi/anim3d/transform3d",
  "mizchi/mesh3d",
  "mizchi/gfx",
  "mizchi/web_runtime_hooks" @hooks,
}

supported_targets = "js"

options(
  link: {
    "js": {
      "exports": [
        "start",
        "set_input",
        "command",
        "snapshot",
        "register_image",
        "renderer_info",
        "register_audio",
        "set_muted",
        "set_volumes",
      ],
      "format": "esm",
    },
  },
)
