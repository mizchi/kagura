warnings = "-1-2-7-20-29-71"

options(
  "is-main": true,
  link: {
    "native": {
      "cc-link-flags": "-L../../deps/wgpu-native/lib -lwgpu_native -lglfw -Wl,-rpath,../../deps/wgpu-native/lib ${build.KAGURA_NATIVE_PLATFORM_LIBS}",
    },
  },
  targets: {
    "snapshot.mbt": ["js"],
    "snapshot_native.mbt": ["native"],
    "main_js.mbt": ["js"],
    "main_native.mbt": ["native"],
  },
)
