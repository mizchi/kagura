import {
  "moonbitlang/core/cmp",
  "moonbitlang/core/math",
  "moonbitlang/core/bench",
  "mizchi/hacknslash_3d/game",
  "mizchi/font",
  "mizchi/kagura_effect_studio" @effect,
  "mizchi/geom/camera3d",
  "mizchi/kagura_core" @core,
  "mizchi/kagura_engine/draw3d",
  "mizchi/kagura_engine" @engine,
  "mizchi/kagura_engine/gltf",
  "mizchi/gfx",
  "mizchi/kagura_game/gameplay2d",
  "mizchi/kagura_core/inpututil",
  "mizchi/kagura_game/interactable2d",
  "mizchi/kagura_engine/light3d",
  "mizchi/geom/math3d",
  "mizchi/mesh3d",
  "mizchi/kagura_game/scene",
  "mizchi/kagura_engine/renderer3d",
  "mizchi/kagura_engine/scene3d",
  "mizchi/kagura_engine/shadow3d",
  "mizchi/kagura_engine/particle3d",
  "mizchi/physics/physics2d",
  "mizchi/kagura_engine/postfx",
  "mizchi/kagura_engine/render_pipeline3d",
  "mizchi/anim3d/skeleton3d",
  "mizchi/anim3d/animation3d",
  "mizchi/kagura_engine/audio",
  "mizchi/anim3d/transform3d",
  "mizchi/pathfind",
  "mizchi/geom/vector",
  "mizchi/terrain/arena_chain",
  "mizchi/terrain/types" @terrain,
  "mizchi/terrain/tinykeep",
  "mizchi/web_runtime_hooks" @web_hooks,
  "mizchi/text",
  "mizchi/atlas",
  "mizchi/atlas",
  "mizchi/kagura_game/hud",
  "mizchi/kagura_game/sprite_packer",
  "mizchi/kagura_engine/sprite2d",
  "mizchi/kagura_engine/ui",
  "moonbitlang/core/debug",
}

warnings = "-1-2-7-29"

supported_targets = "js+native"

pkgtype(kind: "executable")

options(
  link: {
    "native": {
      "cc": "${build.KAGURA_NATIVE_CC}",
      "cc-link-flags": "-L${build.KAGURA_NATIVE_WGPU_LIB_DIR} -lwgpu_native ${build.KAGURA_NATIVE_GLFW_LIBS} ${build.KAGURA_NATIVE_WGPU_RPATH} ${build.KAGURA_NATIVE_PLATFORM_LIBS}",
    },
  },
  targets: {
    "audio_bootstrap_js.mbt": [ "js" ],
    "audio_bootstrap_js_wbtest.mbt": [ "js" ],
    "canvas_css_js.mbt": [ "js" ],
    "canvas_css_native.mbt": [ "native" ],
    "main_js.mbt": [ "js" ],
    "main_js_wbtest.mbt": [ "js" ],
    "main_native.mbt": [ "native" ],
    "save_load.mbt": [ "js" ],
    "save_load_native.mbt": [ "native" ],
    "snapshot.mbt": [ "js" ],
    "snapshot_native.mbt": [ "native" ],
  },
)
