import {
  "moonbitlang/core/cmp" @cmp,
  "moonbitlang/core/math" @math,
  "moonbitlang/core/bench" @bench,
  "mizchi/hacknslash_3d/game" @game,
  "mizchi/font" @font,
  "mizchi/kagura_effect_studio" @effect,
  "mizchi/kagura_core/camera3d" @camera3d,
  "mizchi/kagura_core" @core,
  "mizchi/kagura_engine/draw3d" @draw3d,
  "mizchi/kagura_engine" @engine,
  "mizchi/kagura_engine/gltf" @gltf,
  "mizchi/gfx" @gfx,
  "mizchi/kagura_game/gameplay2d" @gameplay2d,
  "mizchi/kagura_core/inpututil" @inpututil,
  "mizchi/kagura_game/interactable2d" @interactable2d,
  "mizchi/kagura_engine/light3d" @light3d,
  "mizchi/kagura_core/math3d" @math3d,
  "mizchi/kagura_core/mesh3d" @mesh3d,
  "mizchi/kagura_game/scene" @scene,
  "mizchi/kagura_engine/renderer3d" @renderer3d,
  "mizchi/kagura_engine/scene3d" @scene3d,
  "mizchi/kagura_engine/shadow3d" @shadow3d,
  "mizchi/kagura_engine/particle3d" @particle3d,
  "mizchi/kagura_physics/physics2d" @physics2d,
  "mizchi/kagura_engine/postfx" @postfx,
  "mizchi/kagura_engine/render_pipeline3d" @render_pipeline3d,
  "mizchi/kagura_core/skeleton3d" @skeleton3d,
  "mizchi/kagura_core/animation3d" @animation3d,
  "mizchi/kagura_engine/audio" @audio,
  "mizchi/kagura_core/transform3d" @transform3d,
  "mizchi/kagura_physics/pathfind" @pathfind,
  "mizchi/kagura_core/vector" @vector,
  "mizchi/terrain/arena_chain" @arena_chain,
  "mizchi/terrain/types" @terrain,
  "mizchi/terrain/tinykeep" @tinykeep,
  "mizchi/web_runtime_hooks" @web_hooks,
  "mizchi/kagura_engine/text" @text,
  "mizchi/kagura_engine/asset" @asset,
  "mizchi/kagura_core/image_palette" @image_palette,
  "mizchi/kagura_game/hud" @hud,
  "mizchi/kagura_game/sprite_packer" @sprite_packer,
  "mizchi/kagura_engine/sprite2d" @sprite2d,
  "mizchi/kagura_engine/ui" @ui,
}

warnings = "-1-2-7-29"

supported_targets = "js+native"

options(
  "is-main": true,
  link: {
    "native": {
      "cc": "${build.KAGURA_NATIVE_CC}",
      "cc-link-flags": "-L../../deps/wgpu-native/lib -lwgpu_native ${build.KAGURA_NATIVE_GLFW_LIBS} ${build.KAGURA_NATIVE_WGPU_RPATH} ${build.KAGURA_NATIVE_PLATFORM_LIBS}",
    },
  },
  targets: {
    "audio_bootstrap_js.mbt": [ "js" ],
    "audio_bootstrap_js_wbtest.mbt": [ "js" ],
    "canvas_css_js.mbt": [ "js" ],
    "canvas_css_native.mbt": [ "native" ],
    "main_js.mbt": [ "js" ],
    "main_js_wbtest.mbt": [ "js" ],
    "main_native.mbt": [ "native" ],
    "save_load.mbt": [ "js" ],
    "save_load_native.mbt": [ "native" ],
    "snapshot.mbt": [ "js" ],
    "snapshot_native.mbt": [ "native" ],
  },
)
