import {
  "mizchi/kagura/engine/audio" @audio,
  "mizchi/glfw" @glfw,
}

options(
  link: {
    "native": {
      "cc": "${build.KAGURA_NATIVE_CC}",
      "cc-flags": "-Ideps/wgpu-native/include -Ideps/miniaudio ${build.KAGURA_NATIVE_GLFW_CFLAGS}",
      "cc-link-flags": "-Ldeps/wgpu-native/lib -lwgpu_native ${build.KAGURA_NATIVE_GLFW_LIBS} -Wl,-rpath,deps/wgpu-native/lib ${build.KAGURA_NATIVE_AUDIO_LIBS}",
    },
  },
  "native-stub": [ "wgpu_native_stub.c", "wgpu_native_stub_macos.m" ],
  "supported-targets": [ "native" ],
  targets: {
    "audio_backend.mbt": [ "native" ],
    "audio_backend_wbtest.mbt": [ "native" ],
    "backend.mbt": [ "native" ],
    "native_io_bindings.mbt": [ "native" ],
    "runtime_bridge.mbt": [ "native" ],
    "runtime_bridge_wbtest.mbt": [ "native" ],
    "wgpu_bindings.mbt": [ "native" ],
    "wgpu_bindings_wbtest.mbt": [ "native" ],
  },
)
