import {
  "mizchi/kagura_engine" @engine,
  "mizchi/gfx",
  "mizchi/native_runtime_hooks/gfx_wgpu_native" @wgpu_native,
  "mizchi/atlas",
  "mizchi/renderer2d",
  "mizchi/widget2d",
  "mizchi/text",
  "mizchi/native_runtime_hooks" @native_hooks,
  "mizchi/crater-renderer/renderer",
  "mizchi/crater-dom/html",
  "mizchi/crater-painter/paint",
  "mizchi/crater-core" @crater_types,
  "mizchi/css/values" @css,
  "mizchi/font",
  "mizchi/image",
  "moonbitlang/core/string",
}

warnings = "-1-2-29"

supported_targets = "native"

pkgtype(kind: "executable")

options(
  link: {
    "native": {
      "cc": "${build.KAGURA_NATIVE_CC}",
      "cc-link-flags": "-L${build.KAGURA_NATIVE_WGPU_LIB_DIR} -lwgpu_native ${build.KAGURA_NATIVE_GLFW_LIBS} ${build.KAGURA_NATIVE_WGPU_RPATH} ${build.KAGURA_NATIVE_PLATFORM_LIBS}",
    },
  },
  targets: {
    "main_native.mbt": [ "native" ],
    "main_stub.mbt": [ "js", "wasm", "wasm-gc", "llvm" ],
  },
)
