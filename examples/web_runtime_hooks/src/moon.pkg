import {
  "mizchi/kagura/engine/asset" @asset,
  "mizchi/kagura/engine/audio" @audio,
  "mizchi/kagura/core" @core,
  "mizchi/kagura/engine" @engine,
  "mizchi/kagura/engine/gfx" @gfx,
  "mizchi/kagura/core/image_palette" @image_palette,
  "mizchi/kagura/core/payload2d" @payload2d,
  "mizchi/kagura/engine/platform" @platform,
  "mizchi/kagura/engine/text" @text,
}

warnings = "-1-29"

options(
  "supported-targets": [ "js", "native", "wasm", "wasm-gc", "llvm" ],
  targets: {
    "hooks_js.mbt": [ "js" ],
    "hooks_llvm.mbt": [ "llvm" ],
    "hooks_stub.mbt": [ "native" ],
    "hooks_wasm.mbt": [ "wasm", "wasm-gc" ],
    "hooks_wbtest.mbt": [ "js", "llvm" ],
  },
)
